# Copy to .env and fill in. .env is gitignored — never commit it.

# ── Storage ───────────────────────────────────────────────────────────────────
# "memory" = in-process dict, lost on restart (default, no setup needed)
# "mongo"  = MongoDB Atlas
STORAGE_BACKEND=mongo
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.zj3jqvq.mongodb.net/?appName=Cluster0
MONGODB_DB=aied

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_BACKEND=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
