# Copy to .env and fill in. .env is gitignored — never commit it.

# ── Storage ───────────────────────────────────────────────────────────────────
# "memory" = in-process dict, lost on restart (default, no setup needed)
# "mongo"  = MongoDB Atlas
STORAGE_BACKEND=mongo
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.zj3jqvq.mongodb.net/?appName=Cluster0
MONGODB_DB=aied

# ── Microsoft sign-in ─────────────────────────────────────────────────────────
# The instructor dashboard's Microsoft app (client) ID — the same value as its
# VITE_MS_CLIENT_ID. Leave empty to turn sign-in off (local dev and tests).
# With it set, every endpoint except / and /health needs
# `Authorization: Bearer <Microsoft ID token>`.
AUTH_MS_CLIENT_ID=
# Cal Poly's directory. Only change this for another tenant.
AUTH_MS_TENANT_ID=1b0d02db-fc9e-4495-9537-1d379cca2ae7
AUTH_ALLOWED_EMAIL_DOMAIN=calpoly.edu

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_BACKEND=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
